{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pom4H/usegit/.usegit/work.schema.json",
  "title": "usegit durable work state",
  "type": "object",
  "required": ["schemaVersion", "id", "goal", "hypothesis", "base", "status", "createdAt", "updatedAt", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^WORK-[A-Za-z0-9._-]+$" },
    "goal": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "experiment": { "type": ["string", "null"] },
    "batchId": { "type": ["string", "null"] },
    "priority": { "type": "number" },
    "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "contract": {
      "type": "object",
      "properties": {
        "success": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["lane", "reasoning", "ready", "source", "blockers", "signals"],
      "properties": {
        "lane": { "enum": ["worker", "control"] },
        "reasoning": { "enum": ["instant", "deep"] },
        "ready": { "type": "boolean" },
        "source": { "enum": ["policy", "explicit", "escalation"] },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "object" }
      },
      "additionalProperties": true
    },
    "base": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ready", "active", "awaiting", "escalated", "accepted", "rejected", "falsified"] },
    "createdBy": { "type": ["string", "null"] },
    "lease": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["owner", "acquiredAt", "expiresAt"],
          "properties": {
            "owner": { "type": "string" },
            "acquiredAt": { "type": "string" },
            "expiresAt": { "type": "string" }
          }
        }
      ]
    },
    "awaiting": { "type": ["object", "null"] },
    "continuation": { "type": ["object", "null"] },
    "selectedContinuation": { "type": ["string", "null"] },
    "escalation": { "type": ["object", "null"] },
    "evidence": { "type": "array" },
    "decision": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
