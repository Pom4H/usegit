{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pom4H/usegit/.usegit/work.schema.json",
  "title": "usegit durable work state",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "goal",
    "base",
    "status",
    "createdAt",
    "updatedAt",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^WORK-[A-Za-z0-9._-]+$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": "number"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array"
    },
    "contract": {
      "type": "object"
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "baseTree": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "active",
        "awaiting",
        "escalated",
        "accepted",
        "rejected",
        "falsified"
      ]
    },
    "createdBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease": {
      "type": [
        "object",
        "null"
      ]
    },
    "awaiting": {
      "type": [
        "object",
        "null"
      ]
    },
    "continuation": {
      "type": [
        "object",
        "null"
      ]
    },
    "selectedContinuation": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "decision": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
