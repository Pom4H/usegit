{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pom4H/usegit/.usegit/experiment.schema.json",
  "title": "usegit experiment",
  "type": "object",
  "required": ["id", "question", "hypothesis", "status", "metrics", "decision"],
  "properties": {
    "id": { "type": "string", "pattern": "^EXP-[0-9]{4,}$" },
    "question": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "running", "accepted", "rejected", "falsified"] },
    "conditions": { "type": "object" },
    "variants": { "type": "array", "items": { "type": "object" } },
    "minimumSamplesPerVariant": { "type": "integer", "minimum": 1 },
    "metrics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "decision": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["outcome", "reason"],
          "properties": {
            "outcome": { "enum": ["accepted", "rejected", "falsified"] },
            "reason": { "type": "string" }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
