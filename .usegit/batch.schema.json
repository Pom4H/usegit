{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pom4H/usegit/.usegit/batch.schema.json",
  "title": "usegit work batch",
  "type": "object",
  "required": [
    "id",
    "work"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object"
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WORK-[A-Za-z0-9._-]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "array"
          },
          "priority": {
            "type": "number"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
